---
/** Full-width call-to-action band with a message button and phone button. */
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Have a project in mind?',
  text = 'You’re welcome to send a message or give us a call. Our team in Doha will get back to you promptly.',
} = Astro.props;
---

<section class="cta">
  <div class="container">
    <div class="reveal">
      <span class="eyebrow">Let’s work together</span>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta__actions reveal" data-delay="1">
      <a class="btn btn--gold" href="/contact/">
        Send a message
        <Icon name="arrow" />
      </a>
      <a class="btn btn--ghost-light" href={`tel:${site.phoneRaw}`}>
        <Icon name="phone" />
        {site.phone}
      </a>
    </div>
  </div>
</section>
