---
/** Site footer: company blurb, link columns, contact details and copyright. */
import Icon from './Icon.astro';
import { activities, site } from '../data/site';
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div>
        <a class="brand brand--on-dark" href="/">
          <img src="/img/logo.svg" alt={site.name} width="118" height="46" />
        </a>
        <h4 class="mt-md">About our company</h4>
        <p>
          A leading Qatari group specialized in the oil and gas sector, with construction, roads and
          manufacturing operations across the Gulf States and Africa.
        </p>
        <div class="footer__social">
          <a href={site.social.facebook} aria-label="Facebook">
            <Icon name="fb" />
          </a>
          <a href={site.social.instagram} aria-label="Instagram">
            <Icon name="ig" />
          </a>
          <a href={site.social.x} aria-label="X (Twitter)">
            <Icon name="tw" />
          </a>
          <a href={site.social.linkedin} aria-label="LinkedIn">
            <Icon name="in" />
          </a>
        </div>
      </div>
      <div>
        <h4>Useful links</h4>
        <div class="footer__links">
          <a href="/">Home</a>
          <a href="/about/">About us</a>
          <a href="/our-activities/">Our activities</a>
          <a href="/contact/">Contact us</a>
          <a href={site.profile} target="_blank" rel="noopener">
            Company profile (PDF)
          </a>
        </div>
      </div>
      <div>
        <h4>Our activities</h4>
        <div class="footer__links">
          {activities.map((a) => (
            <a href={a.href}>{a.label}</a>
          ))}
        </div>
      </div>
      <div>
        <h4>Contact us</h4>
        <ul class="footer__contact">
          <li>
            <Icon name="pin" />
            <span>{site.address}</span>
          </li>
          <li>
            <Icon name="phone" />
            <a href={`tel:${site.phoneRaw}`}>{site.phone}</a>
          </li>
          <li>
            <Icon name="mail" />
            <span>
              <a href={`mailto:${site.email}`}>{site.email}</a>
              <br />
              <a href={`mailto:${site.salesEmail}`}>{site.salesEmail}</a>
              <br />
            </span>
          </li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <span>
        &copy; <span data-year>{new Date().getFullYear()}</span> {site.name}. All rights reserved.
      </span>
      <span>Oil &amp; Gas &middot; Construction &middot; Roads &middot; Agriculture</span>
    </div>
  </div>
</footer>
