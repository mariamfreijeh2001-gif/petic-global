---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ActivityCard from '../components/ActivityCard.astro';
import Feature from '../components/Feature.astro';
import Cta from '../components/Cta.astro';
---

<Base
  title="Our Activities"
  description="Explore Petic International’s activities: roads construction, civil works and construction, agriculture, and oil & gas services."
>
  <PageHero
    crumb="Our activities"
    title="Our activities."
    lead="Oil and gas services and products, civil works, roads and agriculture, delivered with dedicated efficiency, technology and a special focus on safety."
    image="jackup-rig-sunset.jpg"
    alt="Jack-up rig at sunset"
    chip={{ title: '5 activities', sub: 'One standard of quality and safety' }}
    tags={['Oil & gas services', 'Products', 'Civil works', 'Roads', 'Agriculture']}
  />

  <section class="section">
    <div class="container">
      <div class="grid grid--2 grid--loose">
        <ActivityCard
          href="/oil-and-gas/"
          icon="flame"
          wide
          image="gas-flares.jpg"
          alt="Gas flares at a processing plant"
          title="Oil &amp; Gas Services"
          text="Asset integrity inspection by certified teams, material supply from purpose-built facilities in Yemen, integrated onshore and offshore maintenance, static equipment rehabilitation, chemical cleaning, hot tapping, scaffolding, painting and insulation, EPC, pre-commissioning, shutdowns and rig moves."
        />
        <ActivityCard
          href="/oil-and-gas-products/"
          icon="cog"
          wide
          image="product-flange.jpg"
          alt="Forged steel flanges"
          title="Oil &amp; Gas Products"
          text="Forged fittings and flanges to ASME and MSS standards in carbon, stainless, duplex and alloy steels, pipeline products, pressure, level, temperature and flow instrumentation, and chemical solutions for upstream and downstream operations."
          delay={1}
        />
        <ActivityCard
          href="/roads-construction/"
          icon="road"
          wide
          image="roads-rollers-hd.jpg"
          alt="Road rollers compacting asphalt"
          title="Roads Construction"
          text="East Trading &amp; Manufacturing Company has worked hard to maintain its reputation in the construction quality of asphalt roads and highways. It has successfully completed a range of large-scale road projects, from large highways to small commercial site developments, approaching every project with dedicated efficiency, technology and a special focus on safety."
        />
        <ActivityCard
          href="/civil-works-and-construction/"
          icon="building"
          wide
          image="construction-cranes-dusk.jpg"
          alt="Tower cranes on a construction site at dusk"
          title="Civil Works &amp; Construction"
          text="East Trading &amp; Manufacturing Company holds a portfolio of strategic investment in construction equipment, property and a substantial fleet of mobile construction equipment in Tanzania. This complements the company’s multi-domestic growth strategy, which focuses on its operating hubs in East African countries."
          delay={1}
        />
        <ActivityCard
          href="/agriculture/"
          icon="leaf"
          wide
          image="agri-tractors.jpg"
          alt="Fleet of tractors in a field"
          title="Agriculture"
          text="AgriPro is a leading agriculture company dedicated to transforming arable lands into highly productive and sustainable agricultural ventures. With a strong commitment to innovation, technology and environmental responsibility, we provide comprehensive solutions for land development and irrigation systems."
          delay={2}
        />
      </div>
    </div>
  </section>

  <section class="section section--navy section--tight">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Capabilities</span>
        <h2>One group, end-to-end delivery.</h2>
      </div>
      <div class="grid grid--3">
        <Feature icon="doc" title="Design &amp; engineering">
          Design and construction engineering, design-build projects, front-end engineering designs.
        </Feature>
        <Feature icon="cog" title="Construction &amp; management" delay={1}>
          Construction and project management, procurement of materials and equipment, manpower supply.
        </Feature>
        <Feature icon="shield" title="Operation &amp; maintenance" delay={2}>
          Facilities maintenance, concrete repair and waterproofing, long-term operation and maintenance.
        </Feature>
        <Feature icon="users" title="Manpower consultancy">
          Specialized, professional staff of all disciplines, nationals and expatriates, to fulfil client
          needs.
        </Feature>
        <Feature icon="layers" title="Fabrication workshop" delay={1}>
          24,200 m² of workshop space producing 3,000 tons of steel work and 300 tons of plate work per year.
        </Feature>
        <Feature icon="clock" title="Pre-commissioning &amp; shutdowns" delay={2}>
          Turnkey commissioning with our own tracking system and a dedicated shutdown team.
        </Feature>
      </div>
    </div>
  </section>

  <Cta />
</Base>
