---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ActivityCard from '../components/ActivityCard.astro';
import Feature from '../components/Feature.astro';
import Partners from '../components/Partners.astro';
import Cta from '../components/Cta.astro';
import { img } from '../lib/images';
import { site } from '../data/site';

const stats = [
  { icon: 'trophy', value: 77, suffix: '+', label: 'Projects completed for private and public sectors' },
  { icon: 'globe', value: 8, suffix: '', label: 'Countries of operation' },
  { icon: 'clock', value: 10, suffix: '+', label: 'Years in road construction' },
  { icon: 'layers', value: 4, suffix: '', label: 'Business sectors' },
] as const;

const regions = [
  {
    name: 'Gulf States',
    title: 'Middle East operations',
    countries: [
      { code: 'QA', name: 'Qatar', place: 'Doha', text: 'Group headquarters at Al-Nasr Tower, West Bay.' },
      {
        code: 'SA',
        name: 'Saudi Arabia',
        place: 'Al Khobar & Jubail',
        text: 'Operating hubs and a substantial fleet of mobile plant.',
      },
      {
        code: 'OM',
        name: 'Oman',
        place: 'Gulf operations',
        text: 'Projects and services across the Sultanate.',
      },
      {
        code: 'YE',
        name: 'Yemen',
        place: 'Oilfield supply & maintenance',
        text: 'Purpose-built facilities with offices, workshops, warehousing and covered storage.',
      },
    ],
  },
  {
    name: 'Africa',
    title: 'African operations',
    countries: [
      {
        code: 'TZ',
        name: 'Tanzania',
        place: 'Dar es Salaam',
        text: 'East Trading & Manufacturing Company: roads, civil works and construction.',
      },
      { code: 'RW', name: 'Rwanda', place: 'Manufacturing', text: 'Household and pharmaceutical products.' },
      { code: 'UG', name: 'Uganda', place: 'Manufacturing', text: 'Gas cylinder production.' },
      {
        code: 'DZ',
        name: 'Algeria',
        place: 'North Africa',
        text: 'Extending the group’s presence into North Africa.',
      },
    ],
  },
];

const projectFacts = [
  { value: '1,000', unit: 'MMSCFD', label: 'natural gas processed at Khursaniyah Gas Plant' },
  { value: '20,000', unit: 'm³', label: 'concrete poured on the petrochemical plant project' },
  { value: '7,500', unit: 'tons', label: 'of equipment installed' },
  { value: '347,000', unit: 'm²', label: 'of painting works' },
];
---

<Base
  title="Oil & Gas, Construction and Roads"
  description="Petic International is a Qatari group delivering oil and gas services and products, civil works, roads construction and agriculture across the Gulf States and Africa."
>
  <section class="hero">
    <div class="hero__media">
      <Image
        src={img('hero-offshore-sunset.jpg')}
        alt="Offshore platform at sunset"
        widths={[800, 1410]}
        sizes="100vw"
        loading="eager"
      />
    </div>
    <div class="hero__grid-lines" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div>
        <span class="hero__tag reveal">
          <b>Since {site.since}</b> Qatar &middot; Gulf States &middot; Africa
        </span>
        <h1 class="reveal" data-delay="1">
          Building <em>integrated</em> businesses across key sectors.
        </h1>
        <p class="lead reveal" data-delay="2">
          A leading Qatari company specialized in the oil and gas sector, with construction, roads and
          manufacturing operations across the Gulf States and Africa. One simple promise guides every project:{' '}
          <strong>can do</strong>.
        </p>
        <div class="hero__actions reveal" data-delay="3">
          <a class="btn btn--gold" href="/our-activities/">
            Explore our activities
            <Icon name="arrow" />
          </a>
          <a class="btn btn--ghost-light" href="/about/">
            About the group
          </a>
        </div>
      </div>
      <div class="hero__panel reveal" data-delay="2">
        <div class="hero__float">
          <b>77+</b>
          <span>projects delivered worldwide</span>
        </div>
        <div class="hero__card">
          <h3>What we do</h3>
          <div class="hero__list">
            <a href="/oil-and-gas/">
              <span>
                <i>
                  <Icon name="flame" />
                </i>
                Oil &amp; Gas Services
              </span>
              <Icon name="arrow" />
            </a>
            <a href="/oil-and-gas-products/">
              <span>
                <i>
                  <Icon name="cog" />
                </i>
                Oil &amp; Gas Products
              </span>
              <Icon name="arrow" />
            </a>
            <a href="/civil-works-and-construction/">
              <span>
                <i>
                  <Icon name="building" />
                </i>
                Civil Works &amp; Construction
              </span>
              <Icon name="arrow" />
            </a>
            <a href="/roads-construction/">
              <span>
                <i>
                  <Icon name="road" />
                </i>
                Roads Construction
              </span>
              <Icon name="arrow" />
            </a>
            <a href="/agriculture/">
              <span>
                <i>
                  <Icon name="leaf" />
                </i>
                Agriculture
              </span>
              <Icon name="arrow" />
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="hero__scroll" aria-hidden="true">
      <i></i>Scroll
    </div>
  </section>

  <section class="stats" aria-label="Key figures">
    <div class="container">
      {stats.map((s, i) => (
        <div class="stat reveal" data-delay={i || undefined}>
          <i>
            <Icon name={s.icon} />
          </i>
          <div>
            <b>
              <span data-count={s.value} data-suffix={s.suffix}>
                {s.value}
                {s.suffix}
              </span>
            </b>
            <span>{s.label}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section" id="about">
    <div class="container split">
      <div class="split__media reveal">
        <Image
          src={img('workshop-welders.jpg')}
          alt="Welders fabricating steel in the workshop"
          widths={[600, 900, 1410]}
          sizes="(min-width: 960px) 50vw, 100vw"
        />
        <div class="split__badge">
          <b>Can do!</b>
          <span>The Petic International philosophy, fulfilled over and over.</span>
        </div>
      </div>
      <div class="reveal" data-delay="1">
        <span class="eyebrow">Our speciality</span>
        <h2>A leading Qatari company in the oil and gas sector.</h2>
        <p class="lead">
          Petic International specializes in the manufacturing and development of spare parts and specialized
          equipment used in oil wells and various industrial operations. From its headquarters in Qatar, the
          company manages and expands its operations across multiple countries, providing advanced and
          flexible industrial solutions that meet local and international market demands.
        </p>
        <p>
          Recognized for strong technical expertise and a commitment to the highest standards of quality and
          professionalism, Petic International is a trusted partner for companies operating in the energy
          sector. We continuously develop innovative products and effective solutions that enhance operational
          efficiency and performance within the oil and gas industry.
        </p>
        <ul class="checks">
          <li>
            <Icon name="check" />
            <span>Early involvement during feasibility and design development</span>
          </li>
          <li>
            <Icon name="check" />
            <span>Value engineering alternatives and full scrutiny of constructability</span>
          </li>
          <li>
            <Icon name="check" />
            <span>Quality management and excellent safety practices applied daily</span>
          </li>
          <li>
            <Icon name="check" />
            <span>Products and services that comply with international industry standards</span>
          </li>
        </ul>
        <div class="actions">
          <a class="btn btn--navy" href="/about/">
            More about us
            <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft" id="activities">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="reveal">
          <span class="eyebrow">What we do</span>
          <h2>Our activities.</h2>
        </div>
        <p class="lead reveal" data-delay="1">
          Oil and gas services and products, civil works, roads and agriculture, delivered with one standard
          of quality, safety and on-time completion.
        </p>
      </div>
      <div class="grid grid--4">
        <ActivityCard
          href="/oil-and-gas/"
          number="01"
          icon="flame"
          image="gas-flares.jpg"
          alt="Gas flares at a processing plant"
          title="Oil &amp; Gas Services"
          text="Asset integrity, material supply, onshore and offshore maintenance, EPC, pre-commissioning, shutdowns and rig moves for the energy industry."
        />
        <ActivityCard
          href="/oil-and-gas-products/"
          number="02"
          icon="cog"
          image="product-flange.jpg"
          alt="Forged steel flanges"
          title="Oil &amp; Gas Products"
          text="Forged fittings and flanges, pipeline products, pressure and flow instrumentation, and chemical solutions for upstream and downstream operations."
          delay={1}
        />
        <ActivityCard
          href="/civil-works-and-construction/"
          number="03"
          icon="building"
          image="construction-cranes-dusk.jpg"
          alt="Tower cranes on a construction site at dusk"
          title="Civil Works &amp; Construction"
          text="Design-build, construction and project management, with a substantial fleet of mobile construction equipment and more than 77 completed projects."
          delay={2}
        />
        <ActivityCard
          href="/roads-construction/"
          number="04"
          icon="road"
          image="roads-roller-aerial.jpg"
          alt="Road roller compacting fresh asphalt"
          title="Roads Construction"
          text="Asphalt roads, highways and bridges, from earthwork and drainage to paving and aggregate production, with over ten years of experience."
          delay={3}
        />
      </div>
      <div class="actions">
        <a class="link-arrow" href="/agriculture/">
          Also see our agriculture activity, AgriPro
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split split--rev">
      <div class="split__media reveal">
        <Image
          src={img('construction-cranes-dusk.jpg')}
          alt="Construction site with tower cranes"
          widths={[600, 900, 1410]}
          sizes="(min-width: 960px) 50vw, 100vw"
        />
      </div>
      <div class="reveal" data-delay="1">
        <span class="eyebrow">Why choose us</span>
        <h2>The benefit of working with our company.</h2>
        <p class="lead">
          Petic International holds a portfolio of strategic investment in construction equipment, property
          and a substantial fleet of mobile plant in Saudi Arabia. This complements the company’s
          multi-domestic growth strategy, which centres on its operating hubs in Al Khobar, Jubail and Qatar.
        </p>
        <p>
          Our personnel are our most valuable asset. We have gained the trust of our clients and built a
          database of specialized, professional staff of all disciplines, nationals and expatriates, to fulfil
          every client need.
        </p>
        <ul class="checks">
          <li>
            <Icon name="check" />
            <span>Safety first: an HSE management system driving continuous improvement</span>
          </li>
          <li>
            <Icon name="check" />
            <span>Integrated, scalable maintenance resources through a facility’s lifecycle</span>
          </li>
          <li>
            <Icon name="check" />
            <span>Honesty, integrity and the finest work standards on every project</span>
          </li>
        </ul>
        <div class="actions">
          <a class="btn btn--ghost" href="/our-activities/">
            See more
            <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">Our services</span>
        <h2>From the well to the refinery, and the road in between.</h2>
        <p class="lead">
          Every facet of our comprehensive spectrum of services is governed by a high quality standard,
          brought to life daily through quality management, excellent safety practices and customer-oriented
          partnerships.
        </p>
      </div>
      <div class="grid grid--3">
        <Feature icon="shield" title="Asset integrity &amp; inspection">
          Certified teams (API, CSWIP, NACE, ASNT) and an ISO/IEC 17020 accredited inspection body keeping
          ageing assets safe and productive.
        </Feature>
        <Feature icon="cog" title="Maintenance services" delay={1}>
          Integrated onshore and offshore maintenance, static equipment rehabilitation, chemical cleaning, hot
          tapping and shutdown services.
        </Feature>
        <Feature icon="layers" title="EPC &amp; fabrication" delay={2}>
          Engineering, procurement and construction for onshore and offshore projects, backed by a 24,200 m²
          fabrication workshop.
        </Feature>
        <Feature icon="doc" title="Material supply &amp; products">
          Oilfield supply from drilling materials to downstream equipment, plus our own range of fittings,
          flanges and instrumentation.
        </Feature>
        <Feature icon="building" title="Civil works &amp; roads" delay={1}>
          Design-build construction, project management and all phases of road construction with our own
          equipment fleet.
        </Feature>
        <Feature icon="users" title="Manpower consultancy" delay={2}>
          Experienced, highly qualified personnel of all disciplines to fulfil client requirements, nationals
          and expatriates alike.
        </Feature>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="reveal">
          <span class="eyebrow">Our projects</span>
          <h2>Proven on major energy projects.</h2>
        </div>
        <p class="lead reveal" data-delay="1">
          Khursaniyah Gas Plant includes two gas-conditioning trains and ethane and natural gas liquids
          recovery units, producing 550 MMSCFD of sales gas, 240,000 barrels of ethane and NGL, and 1,800
          metric tons of sulphur per day.
        </p>
      </div>
      <div class="grid grid--4">
        {projectFacts.map((f, i) => (
          <div class="pillar reveal" data-delay={i || undefined}>
            <h3>
              {f.value} <small>{f.unit}</small>
            </h3>
            <p>{f.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="reveal">
          <span class="eyebrow">Reliability</span>
          <h2>Systematically achieving the optimum.</h2>
        </div>
        <p class="lead reveal" data-delay="1">
          It is not without reason that Petic International is one of the companies able to document their
          competence in black and white for the benefit of our customers.
        </p>
      </div>
      <div class="pillars">
        <div class="pillar reveal">
          <h3>Projects</h3>
          <p>
            The Petic International philosophy can be put into one simple formula: can do! That is a promise
            we have been fulfilling over and over, and it will remain the highest factor guiding our actions.
          </p>
        </div>
        <div class="pillar reveal" data-delay="1">
          <h3>Mission</h3>
          <p>
            Oil rigs or refineries, power stations or steel mills, piping, mechanical or construction:
            whatever the project, we develop our involvement so that our clients can take a back seat.
          </p>
        </div>
        <div class="pillar reveal" data-delay="2">
          <h3>Think</h3>
          <p>
            Only if you plan with a good degree of foresight can serious mistakes be avoided. Foresight is a
            given at Petic International.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--navy section--tight">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">How we work</span>
        <h2>From plan to hand-over.</h2>
      </div>
      <div class="steps">
        <div class="step reveal">
          <h3>Offering construction plans</h3>
          <p>
            Early involvement during feasibility and design development, securing value engineering
            alternatives.
          </p>
        </div>
        <div class="step reveal" data-delay="1">
          <h3>Project assignment</h3>
          <p>
            Planning and coordination of construction activities and designs, delivered in time to keep work
            uninterrupted.
          </p>
        </div>
        <div class="step reveal" data-delay="2">
          <h3>Building the project</h3>
          <p>Execution within the scheduled time while maintaining our standards of quality and safety.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="quote-band">
    <Image
      src={img('pumpjack-sunset.jpg')}
      alt=""
      aria-hidden="true"
      widths={[800, 1410]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="container reveal">
      <span class="mark" aria-hidden="true">
        “
      </span>
      <blockquote>
        Chase the vision, not the money. <em>The money will end up following you.</em>
      </blockquote>
      <cite>The Petic International philosophy</cite>
    </div>
  </section>

  <section class="section section--navy regions-band">
    <Image
      src={img('world-map.png')}
      alt=""
      aria-hidden="true"
      class="regions-band__map"
      width={1040}
      loading="lazy"
    />
    <div class="container">
      <div class="section-head section-head--split">
        <div class="reveal">
          <span class="eyebrow">Where we operate</span>
          <h2>Present across the Gulf and Africa.</h2>
        </div>
        <p class="lead reveal" data-delay="1">
          Operating hubs in the Gulf States and across Africa, with manufacturing and supply operations that
          keep growing.
        </p>
      </div>
      <div class="regions">
        {regions.map((region, i) => (
          <div class="region reveal" data-delay={i || undefined}>
            <header class="region__head">
              <div>
                <span class="region__label">{region.name}</span>
                <h3>{region.title}</h3>
              </div>
              <b>{region.countries.length} countries</b>
            </header>
            <ul class="region__list">
              {region.countries.map((c) => (
                <li>
                  <span class="region__code" aria-hidden="true">
                    {c.code}
                  </span>
                  <div>
                    <strong>{c.name}</strong>
                    <span class="region__place">{c.place}</span>
                    <p>{c.text}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Partners />
  <Cta />
</Base>
