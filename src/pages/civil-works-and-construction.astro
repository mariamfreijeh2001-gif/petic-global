---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SideNav from '../components/SideNav.astro';
import Gallery from '../components/Gallery.astro';
import ServiceList from '../components/ServiceList.astro';
import Cta from '../components/Cta.astro';
import { heavyEquipment } from '../data/site';

const capabilities = [
  'Design and construction engineering',
  'Design-build projects',
  'Construction and project management',
  'Procurement of materials and equipment',
  'Manpower supply and personnel services',
  'Facilities maintenance',
  'Concrete repair and waterproofing',
  'Fabrication and installation of piping, steel structures and equipment',
];
---

<Base
  title="Civil Works and Construction"
  description="Petic International civil works and construction: design-build, project management, procurement, manpower and facilities maintenance in Tanzania and the Gulf."
>
  <PageHero
    crumb="Civil works and construction"
    title="Civil works &amp; construction."
    lead="Strategic investment in construction equipment, property and a substantial fleet of mobile plant, supporting projects across East Africa and the Gulf."
    image="construction-cranes-dusk.jpg"
    alt="Tower cranes on a construction site at dusk"
    chip={{ title: '77+ projects', sub: 'Completed for private and public sectors' }}
    tags={['Design-build', 'Project management', 'Procurement', 'Maintenance']}
  />

  <section class="section">
    <div class="container detail">
      <div class="prose">
        <span class="eyebrow reveal">Overview</span>
        <h2 class="reveal">Depth of resources, skilled teams.</h2>
        <p class="lead reveal" data-delay="1">
          East Trading &amp; Manufacturing Company holds a portfolio of strategic investment in construction
          equipment, property and a substantial fleet of mobile construction equipment in Tanzania. This
          complements the company’s multi-domestic growth strategy, which focuses on its operating hubs in
          East African countries.
        </p>

        <h3 class="reveal">East Trading</h3>
        <p class="reveal">
          East Trading’s heavy earthmoving equipment, skilled operatives and expertise in the work and local
          environment have enabled the company to be involved in many important civil and construction
          projects in Tanzania. The company strives to provide the best solution to its clients: it has the
          depth of resources and skilled labour teams to take projects from concept through construction,
          recognizing suggestions about improvements that lead to success.
        </p>
        <p class="reveal">
          East Trading &amp; Manufacturing Company and its main group Petic International have already
          completed more than 77 projects of various sizes for private and public sectors worldwide. Our heavy
          earthmoving equipment, skilled operatives and expertise in the local working environment have also
          enabled the company to be involved in many important civil and construction projects in Yemen.
        </p>

        <Gallery
          items={[
            { file: 'civil-bridge-beam.jpg', alt: 'Bridge beam being lifted into place by crane' },
            { file: 'pipeline-rack.jpg', alt: 'Pipeline rack installation' },
            { file: 'desert-road-truck.jpg', alt: 'Earthworks on a desert road project' },
          ]}
        />

        <h3 class="reveal">Our construction capability</h3>
        <p class="reveal">
          The capability in construction and the range of construction services offered by the group includes:
        </p>
        <div class="reveal mt-sm">
          <ServiceList items={capabilities} />
        </div>

        <h3 class="reveal">Our equipment fleet</h3>
        <p class="reveal">
          A substantial fleet of mobile construction equipment and transport vehicles supports our civil
          works, road construction, and construction and maintenance services. Heavy equipment is also
          available on a contract or rental basis:
        </p>
        <div class="reveal mt-sm">
          <ServiceList items={[...heavyEquipment]} />
        </div>
        <Gallery
          items={[
            { file: 'fleet-mixer-truck-hd.jpg', alt: 'Concrete mixer truck' },
            { file: 'fleet-loader.jpg', alt: 'Wheel loader and tipper truck' },
            { file: 'fleet-tipper-hd.jpg', alt: 'Tipper truck in the yard' },
          ]}
        />
        <a class="btn btn--navy reveal" href="/contact/">
          Start a project
          <Icon name="arrow" />
        </a>
      </div>
      <SideNav />
    </div>
  </section>

  <Cta
    title="Need a civil works partner?"
    text="Design-build, project management, procurement and maintenance from one accountable team."
  />
</Base>
