---

<Base
  title="Oil &amp; Gas Products"
  description="Petic International products for the oil and gas industry: forged fittings and flanges, pipeline products, pressure, level, temperature and flow instrumentation, and chemical solutions."
>
  <PageHero
    crumb="Oil &amp; gas products"
    title="Oil &amp; gas products."
    lead="Forged fittings and flanges, pipeline products, process instrumentation and chemical solutions, manufactured and supplied to international standards for oil and gas, petrochemical, energy and process industries."
    image="product-flange.jpg"
    alt="Forged steel flanges"
    chip={{ title: 'ASME &middot; MSS', sub: 'Made to international standards' }}
    tags={['Fittings', 'Flanges', 'Pipeline', 'Instrumentation', 'Chemicals']}
  />

  <section class="section">
    <div class="container detail">
      <div class="prose prose--wide">
        <span class="eyebrow reveal">Our products</span>
        <h2 class="reveal">Reliable connections for critical piping systems.</h2>
        <p class="lead reveal" data-delay="1">
          We manufacture and supply a complete range of industrial fittings, flanges, pipeline products and
          instruments. Engineered for strength, precision and corrosion resistance, they ensure secure sealing
          performance and long-term durability under demanding operating conditions.
        </p>

        <div class="carousel-head reveal mt-md">
          <div>
            <h3>Fittings &amp; flanges</h3>
            <p>Scroll to browse the range. Drag, swipe or use the arrows.</p>
          </div>
        </div>
        <ProductCarousel id="fittings" items={fittings} />

        <h3 class="reveal mt-md">Common materials</h3>
        <div class="reveal mt-sm">
          <ServiceList items={materials} />
        </div>

        <div class="carousel-head reveal mt-lg">
          <div>
            <h3>Instrumentation</h3>
            <p>Pressure, level, temperature and flow instruments with digital outputs.</p>
          </div>
        </div>
        <ProductCarousel id="instruments" items={instruments} />

        <div class="carousel-head reveal mt-lg">
          <div>
            <h3>Pipeline products</h3>
            <p>Pipe, bends and prefabricated assemblies for pressure and abrasive service.</p>
          </div>
        </div>
        <ProductCarousel id="pipeline" items={pipeline} contain={false} />

        <h3 class="reveal mt-lg">Chemical solutions</h3>
        <div class="grid grid--3 mt-sm reveal">
          <div class="pillar">
            <h3>Upstream well services</h3>
            <ul>
              {upstreamWell.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </div>
          <div class="pillar">
            <h3>Upstream production</h3>
            <ul>
              {upstreamProduction.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </div>
          <div class="pillar">
            <h3>Downstream treatment</h3>
            <ul>
              {downstream.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </div>
        </div>
        <a class="btn btn--navy reveal mt-md" href="/contact/">
          Request a quotation
          <Icon name="arrow" />
        </a>
      </div>
      <SideNav />
    </div>
  </section>

  <Cta
    title="Looking for a specific fitting, instrument or chemical?"
    text="Send us the specification and our supply team will respond with availability and pricing."
  />
</Base>
